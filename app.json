{
  "expo": {
    "name": "SoThuChiMobile",
    "slug": "SoThuChiMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sothuchimobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A5CF0",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Sổ Thu Chi chọn ảnh hóa đơn để đính kèm vào giao dịch.",
          "cameraPermission": "Cho phép Sổ Thu Chi chụp ảnh hóa đơn để đính kèm vào giao dịch."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0F2F5",
          "image": "./assets/images/app-icon-512.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#18191A",
            "image": "./assets/images/app-icon-512.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cho phép Sổ Thu Chi lưu ảnh bill vào thư viện ảnh của bạn.",
          "photosPermission": "Cho phép Sổ Thu Chi lưu ảnh bill vào thư viện ảnh của bạn.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
